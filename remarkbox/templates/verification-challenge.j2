{% extends request.base_funnel_template -%}
{% block title %}verify code | {{ request.domain }}{% endblock -%}
{% block content %}
<section class="join-or-log-in">
   <b>Verification Code</b>
   <br/>
   {% if use_totp %}
   Enter the 6-digit code from your authenticator app, or one of your backup codes.
   {% else %}
   Please enter code to log in.
   {% endif %}
   <br/>
   <form method="post" action="{{ request.link_prefix }}/verification-challenge">
      <input
          name        = "email"
          type        = "hidden"
          id          = "email_input"
          class       = "common-text-input"
          value       = "{{ email }}"
          placeholder = "Your Email Address" />

      <input
          name        = "raw-otp"
          type        = "{{ 'text' if use_totp else 'number' }}"
          id          = "raw-otp"
          class       = "common-text-input"
          tabindex    = "1"
          value       = "{% if raw_otp  %}{{ raw_otp }}{% endif %}"
          placeholder = "6 digit challenge verification code"
          required
          autofocus />

    <p>
    <input type="submit" name="submit" id="submit" class="rb-submit red-button button-max-width send-log-in-email" value="verify code" required />
    <p/>

   </form>

   {% if use_totp %}
   <form method="post" action="{{ request.link_prefix }}/verification-challenge">
      <input name="email" type="hidden" value="{{ email }}" />
      <input type="submit" name="send-email" value="email me a code instead" class="rb-submit button-max-width" />
   </form>
   {% endif %}

</section>
{%- endblock -%}
